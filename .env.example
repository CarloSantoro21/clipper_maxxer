# Comando para el planner. Por defecto usa Claude Code en modo headless con tu suscripción.
CLIPFORGE_CLAUDE_BIN=claude
# Modelo que usa el planner (alias de Claude Code: sonnet, opus...)
CLIPFORGE_MODEL=sonnet
# Modelo de Whisper: tiny, base, small, medium, large-v3. "small" va bien en CPU; "large-v3" si tienes GPU.
CLIPFORGE_WHISPER_MODEL=small
# cpu o cuda
CLIPFORGE_DEVICE=cpu
# Voz por defecto del modo story (edge-tts --list-voices para ver todas)
CLIPFORGE_TTS_VOICE=es-MX-JorgeNeural
